# Upstash Redis (vía Vercel Marketplace o directamente desde Upstash).
# En el panel de Vercel: Storage → Marketplace → Upstash Redis → Connect.
# Vercel inyecta KV_REST_API_URL / KV_REST_API_TOKEN y también
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN automáticamente en
# producción y preview. La app acepta cualquiera de los dos pares.
# Para desarrollo local copia este archivo a .env.local y rellena uno
# de los pares con los valores de Upstash/Vercel (.env.local se ignora
# en git). Si no rellenas nada, la app usa un store en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Contraseña del panel admin (sin comillas). Si no se define, se usa
# "RuvaBase123!" como valor por defecto, igual que en el enunciado.
ADMIN_PASSWORD=RuvaBase123!
